---
import "../styles/base.css";
import "../styles/main.css";

import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Analytics from "./partials/Analytics.astro";
import StructuredData from "./partials/StructuredData.astro";
import Seo from "@layouts/partials/Seo.astro";
import Header from "@components/partials/Header.svelte";
import Footer from "@components/partials/Footer.svelte";

export interface Props {
  title: string;
  description?: string;
  extraStyles?: string;
}

const { title, description, extraStyles } = Astro.props;
const defaultDescription =
  "Creative direction from Seed to Series A. In-house product development. For founders who've already proven the idea.";
const currentURL = new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      function applyTheme() {
        const theme = localStorage.getItem("theme") || "light";
        const meta = document.querySelector('meta[name="theme-color"]');

        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          if (meta) meta.setAttribute("content", "#030712");
        } else {
          document.documentElement.classList.remove("dark");
          if (meta) meta.setAttribute("content", "#f5f5f4");
        }
      }

      // Apply on initial load
      applyTheme();

      // Reapply after ClientRouter navigation
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <ClientRouter />
    <Font cssVariable="--font-general-sans" preload />
    <Font cssVariable="--font-azeret-mono" preload />
    <Seo
      {title}
      description={description || defaultDescription}
      canonical={currentURL}
      openGraph={{
        url: currentURL,
        title: title,
        description: description || defaultDescription,
        images: [
          {
            url: Astro.site + "/images/site-default.webp",
            height: 630,
            width: 1200,
            alt: "Paul Mackenzie — Creative Director, workingon.studio",
          },
        ],
        site_name: "Paul Mackenzie",
        type: "website",
      }}
      twitter={{
        cardType: "summary_large_image",
        handle: "@prmack",
      }}
      additionalMetaTags={[
        {
          name: "twitter:image",
          content: Astro.site + "site-default.webp",
        },
      ]}
    />
    <meta name="theme-color" content="#030712" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script
      is:inline
      type="module"
      src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"
    >
    </script>
    <script is:inline type="module" src="/src/scripts/page-transitions.ts"></script>
    <meta name="generator" content={Astro.generator} />
    <Analytics />
    <StructuredData />
    <title>{title}</title>
  </head>

  <body id="#top" class="background mx-auto flex min-h-dvh max-w-screen-2xl flex-col">
    <div class="sticky top-0 z-50">
      <div class="mx-auto w-full">
        <Header client:load {currentPath} transition:persist />
      </div>
    </div>
    <div class="mx-4 flex flex-1 lg:mx-38">
      <section
        class:list={["flex w-full flex-col gap-30 py-24", extraStyles]}
        data-transition-wrapper
      >
        <slot />
      </section>
    </div>
    <Footer transition:persist />
  </body>
</html>
