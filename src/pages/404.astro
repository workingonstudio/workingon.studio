---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@layouts/partials/PageHeader.astro";
---

<Layout title="404" extraStyles="w-full lg:w-xl py-24">
  <PageHeader>
    <h1 class="text-primary">404</h1>
    <p>Well this sucks.</p>
    <p>Either you have hit a link that doesn't exist anymore.<br />Or you're snooping around.</p>
    <a href="/" class="text-primary text-xs">back home</a>
  </PageHeader>
</Layout>

<style>
  @reference "../styles/main.css";
</style>
