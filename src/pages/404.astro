---
import Layout from "@layouts/Layout.astro";
import PageLayout from "@components/partials/PageLayout.svelte";
---

<Layout title="404">
  <PageLayout extraStyles="w-full lg:w-xl py-12 justify-center">
    <h1 class="text-primary">404</h1>
    <p>Well this sucks.</p>
    <p>Either you have hit a link that doesn't exist anymore. Or you're snooping around.</p>
    <a href="/" class="text-primary text-xs">back home</a>
  </PageLayout>
</Layout>

<style>
  @reference "../styles/main.css";
</style>
