---
import Layout from "@layouts/Layout.astro";
import DaysCounter from "@components/partials/DaysCounter.svelte";
import { getCollection, render } from "astro:content";
import { DateTime } from "luxon";
import PageHeader from "@layouts/partials/PageHeader.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const launchDate = "2025-08-27"; // still an open item — March vs August
const initialDays = Math.floor(DateTime.now().diff(DateTime.fromISO(launchDate), "days").days);

const projectData = await Promise.all(
  projects.map(async (p) => {
    const { Content } = await render(p);
    return {
      slug: p.id,
      title: p.data.title,
      description: p.data.description,
      link: p.data.link,
      externalLink: p.data.externalLink,
      download: p.data.download ?? null,
      image: p.data.image,
      isNew: DateTime.now().diff(DateTime.fromJSDate(p.data.publishedAt), "days").days < 30,
      Content,
    };
  })
);
---

<Layout title="workingon.studio - Projects">
  <PageHeader>
    <h1 class="text-pretty">
      <span class="text-primary">Projects.</span><br />
      <DaysCounter client:load launchDate={launchDate} initialDays={initialDays} /> days passed.
      {projectData.length} projects.<br />These sites are all live.
    </h1>
    <p>Working directly with founders and their teams. Not as a pair of hands. As a guide.</p>
  </PageHeader>
  <div class="grid gap-8 lg:grid-cols-2">
    {
      projectData.map(({ Content, ...project }) => (
        <div class="bg-surface squircle-3xl flex h-60 flex-col justify-between gap-4 p-12">
          <div class="flex flex-col gap-2">
            <div class="flex flex-row items-center gap-3">
              <a
                href={project.externalLink ? project.link : `/projects/${project.link}`}
                target={project.externalLink ? "_blank" : undefined}
                rel={project.externalLink ? "noopener noreferrer" : undefined}
                class="hover:underline"
              >
                <h3>{project.title}.</h3>
              </a>
              {project.isNew && <span class="badge">New</span>}
            </div>
            <p>{project.description}</p>
          </div>
          <ul class="flex flex-row gap-6 text-xs uppercase [&_a]:hover:underline!">
            <li class="flex flex-row gap-2">
              <a
                href={project.externalLink ? project.link : `/projects/${project.link}`}
                target={project.externalLink ? "_blank" : undefined}
                rel={project.externalLink ? "noopener noreferrer" : undefined}
                class="text-primary"
              >
                Visit site
              </a>
              <iconify-icon icon="ph:arrow-up-right-bold" class="text-primary size-4 text-sm" />
            </li>
            {project.download ? (
              <li class="flex flex-row gap-2">
                <a
                  href={project.download}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary"
                >
                  Add to Chrome
                </a>
                <iconify-icon icon="ph:arrow-up-right-bold" class="text-primary size-4 text-sm" />
              </li>
            ) : null}
          </ul>
        </div>
      ))
    }
  </div>
</Layout>

<style>
  @reference "@styles/main.css";
  .badge {
    @apply bg-primary/10 text-contrast font-general-sans rounded-full px-2 py-1 text-[8px] font-semibold uppercase;
  }
</style>
