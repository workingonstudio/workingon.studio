---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import elevenPlay from "../assets/work/eleven-play.png";
import elevenRecord from "../assets/work/eleven-record.png";
import elevenWhy from "../assets/work/eleven-why.png";
import heatoshiAccount from "../assets/work/heatoshi-account.png";
import argoTransactions from "../assets/work/argo-transactions.png";
import heatoshiWeb from "../assets/work/heatoshi-web.png";
import PageHeader from "@layouts/partials/PageHeader.astro";
---

<Layout title="workingon.studio - Creative direction and in-house products" extraStyles="w-full">
  <PageHeader>
    <div class="flex flex-col gap-8 lg:w-xl">
      <h1>
        <span class="text-primary">Creative direction.</span>
        <br />
        For companies ready to grow.
      </h1>
      <div class="flex flex-col gap-4">
        <p>
          I work with companies to raise capital, increase user numbers and customer satisfaction
          through carefully considered creative decisions.
        </p>
        <p>From Seed to Series A to Acquisition.</p>
      </div>
      <a
        href="https://calendar.proton.me/bookings#NVvvSVCpaKbNT4DbZlq5V6A54KEogsB3x3MKEFEWYyY="
        target="_blank"
        class="self-start"
      >
        Book a call
      </a>
    </div>
  </PageHeader>
  <div class="flex flex-col gap-12">
    <div class="flex w-full flex-col lg:w-xl">
      <h2>
        <span class="text-primary">Work.</span>
        <br />
        Selection of works.
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div class="work-wrapper items-center">
        <Image src={elevenPlay} alt="" loading="lazy" class="w-65" format="webp" />
      </div>
      <div class="work-wrapper items-center justify-end">
        <Image src={elevenRecord} alt="" loading="lazy" class="w-65" />
      </div>
      <div class="work-wrapper relative items-center justify-end">
        <Image
          src={elevenWhy}
          class="squircle-3xl absolute top-12 left-12 w-192.5"
          alt=""
          loading="lazy"
          format="webp"
        />
      </div>
      <div class="work-wrapper relative items-center justify-end">
        <Image
          src={heatoshiAccount}
          class="squircle-3xl absolute top-12 left-12 w-192.5"
          alt=""
          loading="lazy"
          format="webp"
        />
      </div>
      <div class="work-wrapper relative items-center justify-end">
        <Image
          src={argoTransactions}
          class="squircle-3xl absolute top-12 left-12 w-195"
          alt=""
          loading="lazy"
          format="webp"
        />
      </div>
      <div class="work-wrapper relative items-center justify-end">
        <Image
          src={heatoshiWeb}
          class="squircle-3xl absolute top-12 left-12 w-195"
          alt=""
          loading="lazy"
          format="webp"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  @reference "@styles/main.css";
  .work-wrapper {
    @apply squircle-3xl bg-surface flex h-88 flex-col overflow-hidden border-transparent p-12;
  }
  .work-wrapper img {
    @apply max-w-none flex-1 object-cover;
  }
  a {
    @apply bg-primary rounded-full border border-transparent px-5 py-3 text-sm font-semibold text-white no-underline;
    @apply hover:text-primary hover:bg-transparent;
    @apply transition-colors duration-300;
  }
</style>
