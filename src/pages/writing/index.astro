---
// src/pages/writing.astro
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";
import PageHeader from "@layouts/partials/PageHeader.astro";

const posts = await getCollection("writing");
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<Layout title="workingon.studio - Writing">
  <PageHeader>
    <h1>
      <span class="text-primary">Writing.</span>
      <br />
      For designers who are tired of design writing.
    </h1>
    <p>Working directly with founders and their teams. Not as a pair of hands. As a guide.</p>
  </PageHeader>
  <div class="grid gap-8 lg:grid-cols-2">
    {
      sortedPosts.map((post) => (
        <div class="bg-surface squircle-3xl flex flex-col gap-4 p-6 lg:p-12">
          <iconify-icon icon={post.data.icon} class="text-primary text-2xl" />
          <div class="flex min-h-20 flex-col gap-2">
            <a href={`/writing/${post.id}`} class="hover:underline">
              <h3>{post.data.title}</h3>
            </a>
            {post.data.description && <p>{post.data.description}</p>}
          </div>
          <div class="text-primary flex flex-row items-center gap-2">
            <a href={`/writing/${post.id}`} class="text-xs uppercase hover:underline">
              Read more
            </a>
            <iconify-icon icon="ph:arrow-up-right-bold" />
          </div>
        </div>
      ))
    }
  </div>
</Layout>
