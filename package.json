{
  "name": "workingon-studio",
  "type": "module",
  "version": "1.3.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run timeline:generate && astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "timeline:generate": "node scripts/generateTimeline.js",
    "timeline:fetch-github": "node scripts/fetchGitHubTimeline.js",
    "timeline:status": "node -e \"const fs=require('fs'); const t=JSON.parse(fs.readFileSync('src/data/timeline.json')); console.log('Source:', t.source||'local-git', '| Generated:', new Date(t.generated).toLocaleString());\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@felte/validator-zod": "^1.0.18",
    "@iconify/svelte": "^5.0.1",
    "@klinking/squircle": "^0.9.0",
    "@octokit/rest": "^22.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "animejs": "^4.5.0",
    "astro": "^7.2.10",
    "dotenv": "^17.2.2",
    "felte": "^1.3.0",
    "gsap": "^3.15.0",
    "luxon": "^3.7.2",
    "melt": "^0.44.0",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "waveform-path": "^0.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
